type ActivityEntry {
  id: String!
  type: String!
  message: String!
  time: DateTime!
}

type DhtCrawlerStatus {
  active: Boolean!
  paused: Boolean!
  pauseReason: String
  torrentsCrawled: Uint64!
  peersConnected: Uint64!
  peersDiscovered: Uint64!
  uptime: Uint64!
  startedAt: DateTime
  recentActivity: [ActivityEntry!]!
}

extend type Query {
  dhtCrawler: DhtCrawlerStatus!
}
