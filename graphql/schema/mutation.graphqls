type Mutation {
  torrent: TorrentMutation!
  retryQueue: RetryQueueMutation!
}

type TorrentMutation {
  reprocess(input: TorrentReprocessInput!): Void
  reindexToElasticsearch: ReindexProgress!
  reclassifyTorrents: ReclassifyProgress!
}

input TorrentReprocessInput {
  infoHashes: [Hash20!]!
  classifierRematch: Boolean
  contentType: ContentType
}

type ReindexProgress {
  total: Int!
  indexed: Int!
  done: Boolean!
  running: Boolean!
  error: String
}

type ReclassifyProgress {
  total: Int!
  processed: Int!
  done: Boolean!
  running: Boolean!
  error: String
}
