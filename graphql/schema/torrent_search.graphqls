input TorrentSearchQueryInput {
  queryString: String
  limit: Int
  page: Int
  offset: Int
  totalCount: Boolean
  """
  hasNextPage if true, the search result will include the hasNextPage field, indicating if there are more results to fetch
  """
  hasNextPage: Boolean
  infoHashes: [Hash20!]
  facets: TorrentSearchFacetsInput
  orderBy: [TorrentSearchOrderByInput!]
  cached: Boolean
  aggregationBudget: Float
  """
  ISO 8601 timestamp. When set, only content created at or before this timestamp
  is included — freezing the result set against newly indexed content during pagination.
  """
  barrier: String
}

input ContentTypeFacetInput {
  aggregate: Boolean
  filter: [ContentType]
}

input TorrentFileTypeFacetInput {
  aggregate: Boolean
  logic: FacetLogic
  filter: [FileType!]
}

input LanguageFacetInput {
  aggregate: Boolean
  filter: [Language!]
}

input ReleaseYearFacetInput {
  aggregate: Boolean
  filter: [Year]
}

input TorrentSearchFacetsInput {
  contentType: ContentTypeFacetInput
  torrentFileType: TorrentFileTypeFacetInput
  language: LanguageFacetInput
  releaseYear: ReleaseYearFacetInput
}

type ContentTypeAgg {
  value: ContentType
  label: String!
  count: Int!
  isEstimate: Boolean!
}

type TorrentFileTypeAgg {
  value: FileType!
  label: String!
  count: Int!
  isEstimate: Boolean!
}

type LanguageAgg {
  value: Language!
  label: String!
  count: Int!
  isEstimate: Boolean!
}

type ReleaseYearAgg {
  value: Year
  label: String!
  count: Int!
  isEstimate: Boolean!
}

type TorrentSearchAggregations {
  contentType: [ContentTypeAgg!]
  torrentFileType: [TorrentFileTypeAgg!]
  language: [LanguageAgg!]
  releaseYear: [ReleaseYearAgg!]
}

type TorrentSearchResult {
  totalCount: Int!
  totalCountIsEstimate: Boolean!
  """
  hasNextPage is true if there are more results to fetch
  """
  hasNextPage: Boolean
  items: [TorrentSearch!]!
  aggregations: TorrentSearchAggregations!
  """The barrier value used to freeze the result set from newly indexed content."""
  barrier: String
}

input TorrentSearchOrderByInput {
  field: TorrentSearchOrderByField!
  direction: SortDirection! = desc
}
