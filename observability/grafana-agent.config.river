local.file_match "hexmagnet" {
	path_targets = [{
		__address__ = "localhost",
		__path__    = "/var/log/hexmagnet/*.log",
		job         = "hexmagnet",
	}]
}

loki.process "hexmagnet" {
	forward_to = [loki.write.default.receiver]

	stage.json {
		expressions = {
			time = "timestamp",
		}
	}

	stage.timestamp {
		source = "time"
		format = "2006-01-02T15:04:05.999999999Z07:00"
	}
}

loki.source.file "hexmagnet" {
	targets    = local.file_match.hexmagnet.targets
	forward_to = [loki.process.hexmagnet.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
	external_labels = {}
}
